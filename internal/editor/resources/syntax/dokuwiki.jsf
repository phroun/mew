# mew syntax file for DokuWiki markup (.txt pages inside a wiki tree)
# Written for mew in the jsf state-machine format.
# SPDX-License-Identifier: MIT  (this grammar file is MIT; see ./LICENSE)
# Headings ====== x ======, **bold**, //italic//, __underline__, ''mono'',
# [[links]], {{media}}, <code>/<file>/<nowiki> blocks, %%nowiki%%,
# list bullets, ^|table separators, > quotes.

=Idle
=Heading	bold
=Bold		bold
=Italic		italic
=Underline	underline
# Combined inline-emphasis classes: **bold**, //italic//, __underline__ nest in
# any combination, so a run carries the FULL active attribute set as one class.
# attrSGR renders each as an absolute attribute state, so moving between them
# (e.g. BoldItalic -> Italic when a nested "**" closes) turns just that
# attribute off while the color and the other attributes stay.
=BoldItalic		bold italic
=BoldUnderline		bold underline
=ItalicUnderline	italic underline
=BoldItalicUnderline	bold italic underline
=Mono		cyan
=Link		bold cyan
=Media		bold cyan
=Code		cyan
=Bullet		red
=Table		bold green
=Quote		green

:bol Idle
	*		text	noeat
	"="		heading	recolor=-1
	" "		indent
	"^|"		tsep	recolor=-1
	">"		quote	recolor=-1
	"\n"		bol

# Indented lines: two-or-more spaces then * or - is a list bullet.
:indent Idle
	*		text	noeat
	" "		indent
	"*\-"		bullet	recolor=-1
	"\n"		bol

:bullet Bullet
	*		text	noeat

:heading Heading
	*		heading
	"\n"		bol

:quote Quote
	*		text	noeat

# A table cell separator (^ header, | cell); the rest of the cell is text.
:tsep Table
	*		text	noeat

:text Idle
	*		text
	"\n"		bol
	"*"		ps0
	"/"		pf0
	"_"		pu0
	"'"		tick1
	"["		br1
	"{"		curl1
	"<"		lt	mark
	"%"		pct1
	"|^"		tsep	recolor=-1

# Inline emphasis — **bold**, //italic//, __underline__ — toggled by doubled
# markers, nesting in any combination. Each body state is one of the eight
# attribute subsets {}, {B}, {I}, {U}, {B,I}, {B,U}, {I,U}, {B,I,U}; a doubled
# marker moves to the state with that attribute flipped (symmetric difference),
# so an inner "**" inside //italic// enters BoldItalic and its closing "**"
# returns to Italic. Opening markers recolor to the richer class; closing
# markers keep the class they were in. Emphasis ends at the line end (an
# approximation: DokuWiki inline spans rarely cross lines). The non-emphasis
# constructs (mono, links, media, code, tables) are recognized only at the
# outermost level, matching the grammar's prior behavior.
:em_b Bold
	*		em_b
	"\n"		bol
	"*"		psB
	"/"		pfB
	"_"		puB

:em_i Italic
	*		em_i
	"\n"		bol
	"*"		psI
	"/"		pfI
	"_"		puI

:em_u Underline
	*		em_u
	"\n"		bol
	"*"		psU
	"/"		pfU
	"_"		puU

:em_bi BoldItalic
	*		em_bi
	"\n"		bol
	"*"		psBI
	"/"		pfBI
	"_"		puBI

:em_bu BoldUnderline
	*		em_bu
	"\n"		bol
	"*"		psBU
	"/"		pfBU
	"_"		puBU

:em_iu ItalicUnderline
	*		em_iu
	"\n"		bol
	"*"		psIU
	"/"		pfIU
	"_"		puIU

:em_biu BoldItalicUnderline
	*		em_biu
	"\n"		bol
	"*"		psBIU
	"/"		pfBIU
	"_"		puBIU

# Bold toggle: one "*" seen; a second flips B, anything else was literal.
:ps0 Idle
	*		text	noeat
	"*"		em_b	recolor=-2

:psB Bold
	*		em_b	noeat
	"*"		text

:psI Italic
	*		em_i	noeat
	"*"		em_bi	recolor=-2

:psU Underline
	*		em_u	noeat
	"*"		em_bu	recolor=-2

:psBI BoldItalic
	*		em_bi	noeat
	"*"		em_i

:psBU BoldUnderline
	*		em_bu	noeat
	"*"		em_u

:psIU ItalicUnderline
	*		em_iu	noeat
	"*"		em_biu	recolor=-2

:psBIU BoldItalicUnderline
	*		em_biu	noeat
	"*"		em_iu

# Italic toggle.
:pf0 Idle
	*		text	noeat
	"/"		em_i	recolor=-2

:pfB Bold
	*		em_b	noeat
	"/"		em_bi	recolor=-2

:pfI Italic
	*		em_i	noeat
	"/"		text

:pfU Underline
	*		em_u	noeat
	"/"		em_iu	recolor=-2

:pfBI BoldItalic
	*		em_bi	noeat
	"/"		em_b

:pfBU BoldUnderline
	*		em_bu	noeat
	"/"		em_biu	recolor=-2

:pfIU ItalicUnderline
	*		em_iu	noeat
	"/"		em_u

:pfBIU BoldItalicUnderline
	*		em_biu	noeat
	"/"		em_bu

# Underline toggle.
:pu0 Idle
	*		text	noeat
	"_"		em_u	recolor=-2

:puB Bold
	*		em_b	noeat
	"_"		em_bu	recolor=-2

:puI Italic
	*		em_i	noeat
	"_"		em_iu	recolor=-2

:puU Underline
	*		em_u	noeat
	"_"		text

:puBI BoldItalic
	*		em_bi	noeat
	"_"		em_biu	recolor=-2

:puBU BoldUnderline
	*		em_bu	noeat
	"_"		em_b

:puIU ItalicUnderline
	*		em_iu	noeat
	"_"		em_i

:puBIU BoldItalicUnderline
	*		em_biu	noeat
	"_"		em_bi

# ''monospace''
:tick1 Idle
	*		text	noeat
	"'"		mono	recolor=-2

:mono Mono
	*		mono
	"\n"		bol
	"'"		mtick1

:mtick1 Mono
	*		mono	noeat
	"'"		text

# [[page|Title]] links
:br1 Idle
	*		text	noeat
	"["		link	recolor=-2

:link Link
	*		link
	"\n"		bol
	"]"		lbr1

:lbr1 Link
	*		link	noeat
	"]"		text

# {{media}}
:curl1 Idle
	*		text	noeat
	"{"		media	recolor=-2

:media Media
	*		media
	"\n"		bol
	"}"		mbr1

:mbr1 Media
	*		media	noeat
	"}"		text

# <code>, <file>, <nowiki> blocks: verbatim until the matching close tag.
:lt Idle
	*		text	noeat
	"a-z"		ltname	buffer

:ltname Idle
	*		text	noeat strings
	"code"		cb_gt
	"file"		cb_gt
	"nowiki"	cb_gt
done
	"a-z"		ltname

:cb_gt Code
	*		text	noeat
	" "		cb_attr
	">"		codeblock	recolormark

# <code lang> attributes before the closing '>'.
:cb_attr Code
	*		cb_attr
	"\n"		bol
	">"		codeblock	recolormark

:codeblock Code
	*		codeblock
	"<"		cb_lt

:cb_lt Code
	*		codeblock	noeat
	"/"		cb_close

:cb_close Code
	*		codeblock	noeat
	"a-z"		cb_cname	buffer

:cb_cname Code
	*		codeblock	noeat strings
	"code"		cb_end
	"file"		cb_end
	"nowiki"	cb_end
done
	"a-z"		cb_cname

:cb_end Code
	*		codeblock	noeat
	">"		text

# %%nowiki%%
:pct1 Idle
	*		text	noeat
	"%"		nowiki	recolor=-2

:nowiki Mono
	*		nowiki
	"%"		npct1

:npct1 Mono
	*		nowiki	noeat
	"%"		text
