-    -lmingw32 -mwindows \
-    -ldinput8 -ldxguid -ldxerr8 -luser32 -lgdi32 -lwinmm -limm32 \
-    -lole32 -loleaut32 -lshell32 -lsetupapi -lversion -luuid \
-    -lhid -lsetupapi -static-libgcc -static" \
