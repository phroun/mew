From 018f42115c16c1a34a452adfa8a0d65c3c3a5138 Mon Sep 17 00:00:00 2001
From: "Jeff R. Day" <phroun@gmail.com>
Date: Thu, 6 Aug 2026 00:26:27 +0000
Subject: [PATCH] tui: assert single-width line baseline on startup
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A fresh TUI launch could show a row doubled (DECDWL) every time, inheriting
a doubled row a previous session had left behind. Entering the alternate
screen does not reset DEC line attributes — DECDWL/DECDHL survive a screen
switch and an erase; only DECSWL (ESC#5), RIS, or a soft reset retire them
— so stale doubling persisted while the freshly allocated frontLineAttr
record (all-zero) claimed the row was normal. EndFrame's reversion path
fires only on a non-zero record, so nothing ever corrected it.

Arm needsLineClear in Init so the first present emits DECSWL for every row,
establishing a known single-width baseline no matter what the terminal
carried in — reusing the exact per-line clear the resize path already uses.
A per-line DECSWL sweep is used deliberately rather than DECSTR/RIS, which
would also tear down the alt-screen, mouse, and keyboard state Init sets up.

Bump Build to 11 (this lands as v0.1.11).
---
 backend/tui/tui.go            | 11 +++++++++++
 backend/tui/tui_width_test.go | 22 ++++++++++++++++++++++
 core/version.go               |  2 +-
 3 files changed, 34 insertions(+), 1 deletion(-)

diff --git a/backend/tui/tui.go b/backend/tui/tui.go
index c1ebd5c..e40d75c 100644
--- a/backend/tui/tui.go
+++ b/backend/tui/tui.go
@@ -281,6 +281,17 @@ func (t *TUIBackend) Init() error {
 	// Allocate buffers
 	t.allocateBuffers()
 
+	// Assert a known single-width baseline on the first frame. frontLineAttr was
+	// just allocated as all-zeros ("every row is normal"), but entering the
+	// alternate screen below does NOT reset DEC line attributes: DECDWL/DECDHL
+	// survive a screen switch and an erase — only DECSWL (ESC#5), RIS, or a soft
+	// reset retires them. So a row a PREVIOUS session left doubled comes back
+	// doubled, while our fresh record says "normal" and the reversion path (which
+	// fires only on a non-zero record) never rescues it — the row stays double-
+	// width every launch. Arming the line clear makes EndFrame emit DECSWL for
+	// every row on the first present, exactly as it does after a resize.
+	t.needsLineClear = true
+
 	// Enable Kitty keyboard protocol for better key detection
 	t.writeTTY("\033[>1u")
 
diff --git a/backend/tui/tui_width_test.go b/backend/tui/tui_width_test.go
index 041b156..1ebdb0e 100644
--- a/backend/tui/tui_width_test.go
+++ b/backend/tui/tui_width_test.go
@@ -210,3 +210,25 @@ func TestTUIDWLRetiredByLineClear(t *testing.T) {
 		t.Errorf("a settled normal row should emit no DEC line mode, got %q", out.String())
 	}
 }
+
+// A fresh backend must assert a single-width baseline on its FIRST present.
+// Entering the alternate screen does not reset DEC line attributes, so a row a
+// previous session left doubled survives into a new launch while the freshly
+// allocated frontLineAttr record (all-zero) says "normal" — and the reversion
+// path fires only on a non-zero record, so the stale doubling would persist
+// every launch. Init arms needsLineClear for exactly this; the first frame must
+// then emit DECSWL (ESC#5) for every row regardless of content.
+func TestTUIFirstFrameAssertsSingleWidthBaseline(t *testing.T) {
+	b, out := newTestTUI(6, 3)
+	b.needsLineClear = true // what Init() now arms at startup.
+
+	b.BeginFrame()
+	b.DrawText(0, 0, "hi", style.DefaultStyle(), nil)
+	b.EndFrame()
+
+	// One ESC#5 per row: a stale doubled row on any line is retired sight unseen.
+	if n := strings.Count(out.String(), "\033#5"); n < b.rows {
+		t.Fatalf("first frame must emit DECSWL (ESC#5) for every row (%d), got %d: %q",
+			b.rows, n, out.String())
+	}
+}
diff --git a/core/version.go b/core/version.go
index c5743b6..7ca8c93 100644
--- a/core/version.go
+++ b/core/version.go
@@ -15,7 +15,7 @@ const Version = "0.1"
 // release number), it is bumped automatically by `make increment`, whose awk
 // script rewrites the single `const Build = N` line below - so keep it on its
 // own line in exactly that form.
-const Build = 10
+const Build = 11
 
 // FullVersion returns the complete version string, major.minor.build (e.g.
 // "0.1.1"), assembled from Version and Build.
-- 
