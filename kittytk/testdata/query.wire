# The corpus every implementation of the query structure answers.
#
# A client hands an application a query taken apart -- source, fields, filter,
# sort -- and a fill taken apart, so that no application parses anything. Three
# client libraries do that taking apart, and they have to arrive at the same
# structure from the same text or the same query means two things.
#
# Each case is two lines. The first is what arrived:
#
#   descriptor <the sequence arguments of `new query` or of the `set` that restates it>
#   fill <the window arguments of `new query` or of `query <q> ...`>
#
# The second is what it has to come out as, written back from the structure:
#
#   want <the same thing, in canonical spelling>
#   bad            (the text must be refused)
#
# `want` is the structure rendered again, so a part dropped on the way in is a
# part missing on the way out. Where the canonical spelling differs from what
# arrived, that is the point of the case: what is compared is the structure.
#
# See docs/hosting-a-query.md and docs/sort-and-filter.md.

# --- the descriptor, at its smallest ---

descriptor source=files
want source="files"

descriptor source="my files"
want source="my files"

descriptor
want

# --- fields: a bag of names, and the same bag is how exclusions are written ---

descriptor source=f fields={ name; size; modified }
want source="f" fields={ name; size; modified }

descriptor source=f fields={} exclude={ thumbnail }
want source="f" exclude={ thumbnail }

# A field list holds names and never values, so it has a shorter spelling:
# the names separated by commas. It reads into the same bag the block does,
# and the block is what comes back out.

descriptor source=f fields=".name, .size"
want source="f" fields={ .name; .size }

descriptor source=f fields="  .name ,.size  " exclude="blob"
want source="f" fields={ .name; .size } exclude={ blob }

descriptor source=f fields=""
want source="f"

# A stray comma leaves a name with nothing in it, which is a typo rather than
# a field. Dropping it quietly would narrow the query by one and say nothing.

descriptor source=f fields=".name, , .size"
bad

descriptor source=f fields=","
bad

# --- a field named by its index ---
#
# A record's field names belong to the data, and a positional member's name is
# its index. A block is a list of statements, so this is the one place where a
# statement's head is not a word.

descriptor source=f fields={ 0; 1; .name }
want source="f" fields={ 0; 1; .name }

descriptor source=f fields="0, 1"
want source="f" fields={ 0; 1 }

# The digits stand as they are written: a name that went out one way comes
# back the same way, so these are two different names.

descriptor source=f fields={ 7; 007 }
want source="f" fields={ 7; 007 }

# A sort level names its field in the head, so an index reaches it.

descriptor source=f sort={ 0 natural; 1 desc }
want source="f" sort={ 0 natural; 1 desc }

# A filter names its field in ARGUMENT position, where a bare 0 is the number
# zero. So a predicate takes its FIRST OPERAND as the field, in whatever form
# it was written, and an index reaches a filter as the number it spells. It
# comes back as a protected symbol, because that is the spelling that says
# name.

descriptor source=f filter={ eq 0 "a" }
want source="f" filter={ eq (0) "a" }

descriptor source=f filter={ eq (0) "a" }
want source="f" filter={ eq (0) "a" }

descriptor source=f filter={ has 7; lacks .name }
want source="f" filter={ has (7); lacks .name }

# A number names the field the decimal it IS, not the digits it was written
# with: in head position `007` and `7` are two different names, but here `007`
# has already been read as the number seven and the zeros are gone. A name
# that wants its zeros says it is a name.

descriptor source=f filter={ eq 007 "a" }
want source="f" filter={ eq (7) "a" }

descriptor source=f filter={ eq (007) "a" }
want source="f" filter={ eq (007) "a" }

# Which is also how a name with no bare spelling at all reaches one. A symbol
# carries every name but the two it has no room for, and a quoted string is a
# name written as text, which carries those.

descriptor source=f filter={ eq (two words) "a" }
want source="f" filter={ eq (two words) "a" }

descriptor source=f filter={ eq "two words" "a" }
want source="f" filter={ eq (two words) "a" }

descriptor source=f filter={ eq "a)b" "x" }
want source="f" filter={ eq "a)b" "x" }

# A bare word is still the ordinary spelling, and still comes back bare.

descriptor source=f filter={ eq name "a" }
want source="f" filter={ eq name "a" }

# A float and a block name nothing: a float has more than one spelling for one
# value, and a block is a set.

descriptor source=f filter={ eq 1.5 "a" }
bad

descriptor source=f filter={ eq { name } "a" }
bad

# And a field is named rather than asserted or argued: `!` and `?` say
# something a name cannot, and a named argument is not an operand at all.

descriptor source=f filter={ eq !name "a" }
bad

descriptor source=f filter={ eq ?name "a" }
bad

descriptor source=f filter={ eq at=name "a" }
bad

# --- the sort ---

descriptor source=f sort={ name }
want source="f" sort={ name }

descriptor source=f sort={ name desc }
want source="f" sort={ name desc }

descriptor source=f sort={ name asc }
want source="f" sort={ name }

descriptor source=f sort={ name fold; size desc; modified desc }
want source="f" sort={ name fold; size desc; modified desc }

descriptor source=f sort={ name natural }
want source="f" sort={ name natural }

descriptor source=f sort={ name exact desc }
want source="f" sort={ name exact desc }

# A collation may also be named, which is how a filter writes one.
descriptor source=f sort={ name collate=natural }
want source="f" sort={ name natural }

# `desc` asserted false is ascending, said out loud.
descriptor source=f sort={ name !desc }
want source="f" sort={ name }

descriptor source=f sort={ name sideways }
bad

descriptor source=f sort={ name desc=1 }
bad

descriptor source=f sort=name
bad

# --- id: a record's identity, which is not a field ---

# It names no field, because an identity is not one: it travels beside a
# record's fields rather than among them.
descriptor source=f filter={ id (left/1) }
want source="f" filter={ id (left/1) }

descriptor source=f filter={ id (left/1) (left/note) 7 "notes" }
want source="f" filter={ id (left/1) (left/note) 7 "notes" }

descriptor source=f filter={ not { id (left/1) } }
want source="f" filter={ not { id (left/1) } }

# A field called `key` is a field like any other, and asks something else.
descriptor source=f filter={ eq key (left/1) }
want source="f" filter={ eq key (left/1) }

descriptor source=f filter={ id }
bad

descriptor source=f filter={ id key (left/1) }
bad

descriptor source=f filter={ id at=(left/1) }
bad

# --- reversed belongs to the scope, not to the sequence ---
#
# A sequence is one prepared ordering and a scope reads it either way, so the
# direction is asked for with the records rather than stated with the sort. The
# descriptor does not carry it at all.

descriptor source=f reversed
want source="f"

scope count=10 reversed
want count=10 reversed

# Every level turns over with it, the one the sort does not write included -- so
# this is the mirror of `sort={ size }`, where `sort={ size desc }` is a third
# sequence again, with ties left facing the way they were.
descriptor source=f sort={ size }
want source="f" sort={ size }

descriptor source=f sort={ size desc }
want source="f" sort={ size desc }

# Asserted false is the sequence as stated, said out loud.
scope count=10 !reversed
want count=10

scope count=10 reversed=1
bad

# --- the filter: a block is an AND, so the top of a parsed tree always is ---

descriptor source=f filter={ eq kind folder }
want source="f" filter={ eq kind folder }

descriptor source=f filter={ eq kind folder; ge size 1024 }
want source="f" filter={ eq kind folder; ge size 1024 }

descriptor source=f filter={}
want source="f" filter={}

# A symbol and a string are different questions, and the value's own spelling
# says which was asked.
descriptor source=f filter={ eq kind "folder" }
want source="f" filter={ eq kind "folder" }

descriptor source=f filter={ ne kind folder; lt size 10; le size 20; gt size 1; ge size 2 }
want source="f" filter={ ne kind folder; lt size 10; le size 20; gt size 1; ge size 2 }

descriptor source=f filter={ or { eq kind folder; eq kind disk } }
want source="f" filter={ or { eq kind folder; eq kind disk } }

descriptor source=f filter={ not { starts name "." } }
want source="f" filter={ not { starts name "." } }

descriptor source=f filter={ and { eq a 1; or { eq b 2; not { eq c 3 } } } }
want source="f" filter={ and { eq a 1; or { eq b 2; not { eq c 3 } } } }

# A set written as a block holds bare names; written as operands it holds any
# value. Both are the same structure, so both come out the same way.
descriptor source=f filter={ in kind { folder; disk } }
want source="f" filter={ in kind folder disk }

descriptor source=f filter={ in kind folder disk }
want source="f" filter={ in kind folder disk }

descriptor source=f filter={ in name "a" "b" 3 }
want source="f" filter={ in name "a" "b" 3 }

descriptor source=f filter={ contains title "report" collate=fold }
want source="f" filter={ contains title "report" collate=fold }

# `collate=` is the one name a predicate reserves, and it reserves it WITH ITS
# VALUE. A bare `collate` is a word like any other bare word here, so a field
# can be called that -- and a collation written with its value left off is
# caught by the operand count rather than by its spelling.

descriptor source=f filter={ eq collate "x" }
want source="f" filter={ eq collate "x" }

descriptor source=f filter={ contains title "report" collate }
bad

descriptor source=f filter={ starts name "READ"; ends name ".md" }
want source="f" filter={ starts name "READ"; ends name ".md" }

# There is no presence operator: undefined is a value with a rank of its own.
descriptor source=f filter={ eq thumbnail undefined }
want source="f" filter={ eq thumbnail undefined }

descriptor source=f filter={ eq deleted false; ne owner nil }
want source="f" filter={ eq deleted false; ne owner nil }

descriptor source=f filter={ lt ratio -2.5 }
want source="f" filter={ lt ratio -2.5 }

# A whole float stays a float: `3` is an integer and `3.0` is not, and a value
# that changed type between the two ends would be comparing different things.
descriptor source=f filter={ lt ratio 3.0 }
want source="f" filter={ lt ratio 3.0 }

descriptor source=f filter={ lt ratio 3 }
want source="f" filter={ lt ratio 3 }

descriptor source=f filter={ eq name "say \"hi\"" }
want source="f" filter={ eq name "say \"hi\"" }

descriptor source=f filter={ between size 1 2 }
bad

descriptor source=f filter={ eq }
bad

descriptor source=f filter={ eq kind }
bad

descriptor source=f filter={ eq kind folder disk }
bad

descriptor source=f filter={ not {} }
bad

descriptor source=f filter={ or }
bad

descriptor source=f filter={ eq kind folder collate=1 }
bad

# An asserted name says something a value cannot, so it is not read as one.
descriptor source=f filter={ eq kind !folder }
bad

descriptor source=f filter={ eq kind ?folder }
bad

descriptor source=f filter=name
bad

# --- everything at once ---

descriptor source="files" fields={ name; size } exclude={ blob } filter={ or { eq kind folder; eq kind disk }; ge size 1024; not { starts name "." } } sort={ name natural; size desc }
want source="files" fields={ name; size } exclude={ blob } filter={ or { eq kind folder; eq kind disk }; ge size 1024; not { starts name "." } } sort={ name natural; size desc }

# --- a scope ---

scope count=30
want count=30

scope count=10 count=x
bad

# The ends are identities. They name records, not positions: what puts a record
# somewhere are its own values, and those belong to whoever holds it.
scope after=17 until=42 count=50
want after=17 until=42 count=50

# An identity is whatever the source that issued it says it is -- a number, a
# name, a composed one with a slash through it.
scope after=(left/1) count=1
want after=(left/1) count=1

scope after="abc" count=1
want after="abc" count=1

# --- a place, for a reader that has one in mind and no identity there ---

# A thumb dragged down a long sequence knows how far down it is and knows no
# record there at all. `from` is best effort and never a promise: the answer's
# `first` says where the scope really began, and a reader that meant somewhere
# else asks again from what it learned.
scope from=600 count=20
want from=600 count=20

# Nought is the beginning, which is where a scope starts anyway, so it asks for
# nothing and is not written back.
scope from=0 count=20
want count=20

scope from=-1 count=20
bad

scope from=x count=20
bad

scope from=1.5 count=20
bad

# A record is not a position. One names a thing, the other names a place, and a
# scope carrying both has a bug that only ever shows here.
scope after=17 from=600 count=20
bad

# Walking backwards from a place: the position is in the SEQUENCE, which is the
# order `total` and `first` are both counted in, and not in the walk.
scope from=600 count=20 reversed
want from=600 count=20 reversed

# Walking the sequence from its end. It names no field, which is what lets it
# turn over a sequence whose records cannot name their own identity at all.
scope count=30 reversed
want count=30 reversed

# No ends at all is the beginning of the sequence, and says so by not being
# there.
scope count=10
want count=10

scope count=10 nonsense=1
want count=10

# A count is a number of records, and there is no such thing as fewer than none.
scope count=-1
bad

scope count=10 after={ name "a" }
bad

scope count=10 after=
bad

# --- a field that names a member of the record rather than a word ---
#
# A data source made of structured records addresses their contents by name,
# and a leading dot is how a name says it is a member: `.size` is the member
# called size, `size` is the word size. It is a word wherever a field name is
# one -- a sort level, a filter predicate, a field bag -- so nothing but the
# lexer has anything to say about it.

descriptor source=f sort={ .name natural; key desc }
want source="f" sort={ .name natural; key desc }

descriptor source=f filter={ eq .key "figaro" }
want source="f" filter={ eq .key "figaro" }

descriptor source=f filter={ ge .0 1024 }
want source="f" filter={ ge .0 1024 }

descriptor source=f fields={ key; .name; value }
want source="f" fields={ key; .name; value }

scope after=3 count=10
want after=3 count=10

# --- a bare token is a number or a symbol, by what it says ---
#
# The two are one run of characters, so which one it is cannot be decided from
# the character it starts with: `2026-09-13` starts like a number and is a date,
# and `1e+21` starts like a date and is a number. The token is read whole and
# measured against the numeric form:
#
#   [+-]? digits ( "." digits )? ( [eE] [+-]? digits )?
#
# written out rather than handed to each language's own number parser, which
# accept different sets of extras. Anything that is not a number is a symbol,
# except a token with a leading sign: that says number and nothing else, so one
# that does not measure up is refused.

descriptor source=f filter={ eq .when 2026-09-13 }
want source="f" filter={ eq .when 2026-09-13 }

descriptor source=f filter={ eq .kind kebab-case }
want source="f" filter={ eq .kind kebab-case }

descriptor source=f filter={ eq .id 1x }
want source="f" filter={ eq .id 1x }

descriptor source=f filter={ eq .n 1e5x }
want source="f" filter={ eq .n 1e5x }

# And what does measure up is a number, integer or float. A float's canonical
# spelling is not settled between the three -- `1e5` writes back as 100000.0
# here and as 1e+05 there -- so the cases below are ones they already agree on,
# and each language covers the rest in its own tests.
descriptor source=f filter={ eq .n 1e+21 }
want source="f" filter={ eq .n 1e+21 }

descriptor source=f filter={ eq .n 6.02e+23 }
want source="f" filter={ eq .n 6.02e+23 }

descriptor source=f filter={ eq .n +3 }
want source="f" filter={ eq .n 3 }

descriptor source=f filter={ eq .n -3.5 }
want source="f" filter={ eq .n -3.5 }

# A leading sign is a number and nothing else.
descriptor source=f filter={ eq .n -x }
bad

descriptor source=f filter={ eq .n +1e }
bad

# A dot leads a member name, so it never leads a number: `.0` is the item at
# position 0 and not the number zero.
descriptor source=f sort={ .0 natural }
want source="f" sort={ .0 natural }

# --- a symbol the grammar has no bare spelling for ---
#
# Parentheses because that is what they already mean: PawScript evaluates a
# block written in braces and preserves what is written in parentheses, and the
# wire's block is braces too. So both languages say the same thing with the same
# brackets -- braces for what is read, parentheses for what is kept as it
# stands.
#
# What can be written bare is written bare, so the brackets appear only where
# they are carrying something.

descriptor source=f filter={ eq .addr (objectLibrary/figaro/3) }
want source="f" filter={ eq .addr (objectLibrary/figaro/3) }

descriptor source=f filter={ eq .kind (*star) }
want source="f" filter={ eq .kind (*star) }

descriptor source=f filter={ eq .n (1e+21) }
want source="f" filter={ eq .n (1e+21) }

descriptor source=f filter={ eq .kind (plain) }
want source="f" filter={ eq .kind plain }

descriptor source=f filter={ eq .kind () }
bad

descriptor source=f filter={ eq .kind (unterminated }
bad

# --- has, lacks, and what cannot be compared ---
#
# A field holding something with no order of its own -- a nested list -- cannot
# be compared against anything: the comparison core calls every such value equal
# to every other, which is what a sort needs and what a filter must not
# inherit. So presence gets operators that do not try to compare, and they take
# no value.

descriptor source=f filter={ has .tags }
want source="f" filter={ has .tags }

descriptor source=f filter={ lacks .thumbnail }
want source="f" filter={ lacks .thumbnail }

descriptor source=f filter={ has .tags; lacks .thumbnail; ge .size 1024 }
want source="f" filter={ has .tags; lacks .thumbnail; ge .size 1024 }

descriptor source=f filter={ not { lacks .tags } }
want source="f" filter={ not { lacks .tags } }

descriptor source=f filter={ has .tags "x" }
bad

descriptor source=f filter={ lacks .tags undefined }
bad

descriptor source=f filter={ has }
bad

# A comparison takes a simple value. A block is a set, and a set is only
# something `in` can be asked about.
descriptor source=f filter={ eq .tags { a; b } }
bad

descriptor source=f filter={ ge .tags {} }
bad

descriptor source=f filter={ in .kind { folder; disk } }
want source="f" filter={ in .kind folder disk }
