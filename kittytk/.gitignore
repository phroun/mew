# Binary executables (example commands built into the repo root).
# Root-anchored so they don't also match the example SOURCE dirs of the
# same name under examples/.
/demo
/demoapp
/editordemo
/kittytk-sdl
/kittytk-tui
/remoteapp
/spawndesktop
*.exe
*.exe~
*.so
*.dylib

# Built binaries (make build -> bin/)
/bin/

# Example binaries built in place. `go build ./examples/keytest` from this
# directory drops a 60MB+ executable named for the package right here, and a
# `git add -A` sweeps it into the commit — which is exactly how one reached
# this repository once. The sync policy's fourth self-audit check exists to
# catch binary blobs in a diff; this stops them getting that far.
# (/demo and /demoapp are already covered above.)
/keytest

# Test binary
*.test

# Python bytecode
__pycache__/
*.pyc

# C example binaries
/c/demoapp
/c/counter
/c/mewdemo
/c/interop_smoke
/c/demoapp_smoke

# Output of go coverage
*.out

# IDE/editor files
.idea/
.vscode/
*.swp
*.swo
*~

.DS_Store
DEADJOE
