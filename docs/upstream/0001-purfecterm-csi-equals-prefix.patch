From 9c465af5262dc5b43669446da2c20593085d7bd5 Mon Sep 17 00:00:00 2001
From: mew <phroun@gmail.com>
Date: Tue, 28 Jul 2026 23:25:57 +0000
Subject: [PATCH] parser: '=' is a CSI private parameter prefix

A TUI resets the Kitty keyboard protocol on the way out with
CSI = 0 ; 1 u. handleCSI recognized '?', '>', '!' and '<' as private
parameter prefixes but not '=', so the '=' fell through to the
final-byte branch: the sequence was executed (as an unknown final) and
ended right there, leaving "0;1u" to be processed from ground state and
printed. Quitting a full-screen program inside PurfecTerm left "0;1u"
in the top-left corner, in front of the shell prompt.

The private parameter prefixes are the whole 0x3C-0x3F range per
ECMA-48 -- '<', '=', '>', '?' -- and all four have to be RECOGNIZED
even where the sequence is unsupported, so the parameters are consumed
with it rather than printed. Match on the range. ('!' is an
intermediate byte rather than a prefix, but CSI ! p carries it in the
prefix position, so it stays.)

An unsupported final byte with no prefix was already handled correctly
and stays that way; there is a test for it so the fix cannot regress it.
---
 csiprivate_test.go | 69 ++++++++++++++++++++++++++++++++++++++++++++++
 parser.go          | 17 ++++++++++--
 2 files changed, 84 insertions(+), 2 deletions(-)
 create mode 100644 csiprivate_test.go

diff --git a/csiprivate_test.go b/csiprivate_test.go
new file mode 100644
index 0000000..4a5eb6d
--- /dev/null
+++ b/csiprivate_test.go
@@ -0,0 +1,69 @@
+package purfecterm
+
+import (
+	"strings"
+	"testing"
+)
+
+// screen returns everything visible, so a test can assert that a control
+// sequence left NOTHING behind.
+func screen(b *Buffer) string {
+	cols, rows := b.GetSize()
+	var sb strings.Builder
+	for y := 0; y < rows; y++ {
+		for x := 0; x < cols; x++ {
+			if c := b.GetVisibleCell(x, y); c.Char != 0 {
+				sb.WriteRune(c.Char)
+			} else {
+				sb.WriteByte(' ')
+			}
+		}
+	}
+	return strings.TrimRight(sb.String(), " ")
+}
+
+// A CSI sequence carrying a private parameter prefix must be CONSUMED WHOLE,
+// supported or not. The four prefixes are 0x3C-0x3F: '<', '=', '>', '?'.
+//
+// An unrecognized prefix used to end the sequence on the spot, leaving the
+// parameters to be printed as ordinary text. The case that showed it: a TUI
+// resetting the Kitty keyboard protocol on exit with CSI = 0 ; 1 u left
+// "0;1u" on the screen as it quit.
+func TestCSIPrivatePrefixesAreConsumed(t *testing.T) {
+	for _, seq := range []string{
+		"\x1b[<u",      // Kitty keyboard: pop the flag stack
+		"\x1b[>1u",     // Kitty keyboard: push flags
+		"\x1b[=0;1u",   // Kitty keyboard: reset flags -- the reported bug
+		"\x1b[?25h",    // DECTCEM, a supported one, for contrast
+		"\x1b[>4;2m",   // modifyOtherKeys
+		"\x1b[<0;0;0m", // an unsupported '<' form
+		"\x1b[=c",      // DA3
+		"\x1b[!p",      // DECSTR
+	} {
+		b := NewBuffer(40, 3, 100)
+		NewParser(b).Parse([]byte(seq))
+		if got := screen(b); got != "" {
+			t.Errorf("%q left %q on the screen; a private-prefixed CSI must be consumed whole", seq, got)
+		}
+	}
+}
+
+// The whole teardown a TUI writes on its way out, in one go: it must leave a
+// clean screen behind for the shell prompt.
+func TestTUITeardownLeavesNothingOnScreen(t *testing.T) {
+	b := NewBuffer(40, 3, 100)
+	NewParser(b).Parse([]byte("\x1b[?1049l\x1b[<u\x1b[=0;1u"))
+	if got := screen(b); got != "" {
+		t.Errorf("teardown left %q on the screen", got)
+	}
+}
+
+// The guard on the fix: an unsupported final byte with NO private prefix is
+// still consumed with its parameters, which already worked.
+func TestUnsupportedFinalByteIsStillConsumed(t *testing.T) {
+	b := NewBuffer(40, 3, 100)
+	NewParser(b).Parse([]byte("\x1b[3;4Z"))
+	if got := screen(b); got != "" {
+		t.Errorf("unsupported CSI left %q on the screen", got)
+	}
+}
diff --git a/parser.go b/parser.go
index 75d565d..0547088 100644
--- a/parser.go
+++ b/parser.go
@@ -258,8 +258,21 @@ func (p *Parser) handleDECLineAttr(b byte) {
 
 func (p *Parser) handleCSI(b byte) {
 	if p.state == stateCSI {
-		// First byte after ESC [
-		if b == '?' || b == '>' || b == '!' || b == '<' {
+		// First byte after ESC [. The private parameter prefixes are the
+		// whole 0x3C-0x3F range -- '<', '=', '>', '?' -- per ECMA-48. All
+		// four have to be RECOGNIZED even where the sequence itself is not
+		// supported: an unrecognized prefix falls through to the final-byte
+		// branch below, which ends the sequence on the prefix and prints the
+		// parameters that follow as text.
+		//
+		// '=' is the one that bites. A TUI resets the Kitty keyboard protocol
+		// on the way out with CSI = 0 ; 1 u, and a terminal that does not know
+		// '=' is a prefix leaves "0;1u" sitting on the screen as the program
+		// exits.
+		//
+		// '!' (0x21) is an intermediate byte rather than a parameter prefix,
+		// but CSI ! p (DECSTR) carries it in the prefix position, so it stays.
+		if b == '!' || (b >= 0x3C && b <= 0x3F) {
 			p.csiPrivate = b
 			p.state = stateCSIParam
 			return
-- 
