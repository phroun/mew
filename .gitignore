.DS_Store
/mew
bin/
.#*
# Built host binaries: `go build ./cmd/mew-sdl` from app/ drops its output
# beside the source, and a 71 MB blob per build has no business in history.
/app/mew
/app/mew-sdl

# Generated Windows icon resource object (make windows-sdl).
app/cmd/*/*.syso

# PTY session diagnostics: ptyLogName, written to the CWD wherever mew runs.
# Running the editor tests leaves one in internal/editor/, and it had been
# tracked -- growing by a few sessions with every commit that followed a test
# run.
mew-pty-diag.log

# Fetched SDL3 runtime cache (scripts/fetch-sdl3.sh); not committed.
build/

# Fetched wgpu-native runtime, embedded into the Windows build (scripts/fetch-wgpu.sh).
app/internal/wgpuembed/wgpu_native.dll
